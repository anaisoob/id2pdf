#: src/id2pdf/cli.py:18
msgid ""
"Scan both sides of an ID card onto one A4 page, as a PDF. The card may lie "
"anywhere on the scanner glass; it is found, straightened and cut out."
msgstr ""
"Skenira obje strane osobne iskaznice na jednu A4 stranicu, kao PDF. Osobna "
"može ležati bilo gdje na staklu skenera; skripta je pronađe, izravna i "
"izreže."

#: src/id2pdf/cli.py:22
msgid "the PDF to write (with --diagnose: a folder for the scan)"
msgstr "PDF koji se sprema (uz --diagnose: mapa za sken)"

#: src/id2pdf/cli.py:29
msgid "use existing scans or photos of the two sides instead of scanning"
msgstr ""
"koristi postojeće skenove ili fotografije obiju strana umjesto skeniranja"

#: src/id2pdf/cli.py:31
msgid "scan N plain A4 pages instead of a card"
msgstr "skenira N običnih A4 stranica umjesto kartice"

#: src/id2pdf/cli.py:33
msgid "scan the glass and print what is found (numbers only)"
msgstr "skenira staklo i ispiše što je pronađeno (samo brojevi)"

#: src/id2pdf/cli.py:35
msgid "SANE device (default: the first scanner in 'scanimage -L')"
msgstr "SANE uređaj (zadano: prvi skener iz 'scanimage -L')"

#: src/id2pdf/cli.py:36
msgid "overwrite the output without asking"
msgstr "zamijeni postojeću datoteku bez pitanja"

#: src/id2pdf/cli.py:44
msgid "the output PDF is required"
msgstr "potreban je izlazni PDF"

#: src/id2pdf/cli.py:46
#, python-brace-format
msgid "{path} already exists. Overwrite? [y/N] "
msgstr "{path} već postoji. Zamijeniti? [d/N] "

#: src/id2pdf/cli.py:47
msgid "y"
msgstr "d"

#: src/id2pdf/cli.py:48
msgid "Nothing was changed."
msgstr "Ništa nije promijenjeno."

#: src/id2pdf/cli.py:55
#, python-brace-format
msgid "Scanner: {device}"
msgstr "Skener: {device}"

#: src/id2pdf/cli.py:66
msgid "Cancelled, nothing was saved."
msgstr "Prekinuto, ništa nije spremljeno."

#: src/id2pdf/cli.py:67
#, python-brace-format
msgid "Saved: {path}"
msgstr "Spremljeno: {path}"

#: src/id2pdf/scanner.py:34
msgid "The scanimage command is missing (package sane)."
msgstr "Nema naredbe scanimage (paket sane)."

#: src/id2pdf/scanner.py:36
msgid "'scanimage -L' failed:"
msgstr "'scanimage -L' nije uspio:"

#: src/id2pdf/scanner.py:40
msgid "No scanner found. Check 'scanimage -L'."
msgstr "Skener nije pronađen. Provjerite 'scanimage -L'."

#: src/id2pdf/scanner.py:57
msgid "The scanner is still busy, trying again..."
msgstr "Skener je još zauzet, pokušavam ponovno..."

#: src/id2pdf/scanner.py:60
msgid "Scanning failed:"
msgstr "Skeniranje nije uspjelo:"

#: src/id2pdf/scanner.py:65
msgid "Then press Enter (Ctrl+C to cancel) "
msgstr "Zatim pritisnite Enter (Ctrl+C za prekid) "

#: src/id2pdf/scanner.py:71
msgid ""
"Put the card on the glass front side down, anywhere (text upright), and "
"close the lid."
msgstr ""
"Stavite osobnu prednjom stranom prema staklu, bilo gdje (tekst uspravno), i "
"zatvorite poklopac."

#: src/id2pdf/scanner.py:73
msgid ""
"Put the card on the glass back side down, anywhere (text upright), and close "
"the lid."
msgstr ""
"Stavite osobnu stražnjom stranom prema staklu, bilo gdje (tekst uspravno), i "
"zatvorite poklopac."

#: src/id2pdf/scanner.py:75
msgid "Looking for the card on the glass..."
msgstr "Tražim osobnu na staklu..."

#: src/id2pdf/scanner.py:80
msgid ""
"No card found. Put it away from the edge of the glass, flat, and close the "
"lid."
msgstr ""
"Osobna nije pronađena. Stavite je dalje od ruba stakla, ravno, i zatvorite "
"poklopac."

#: src/id2pdf/scanner.py:82
msgid "There is more than one card on the glass, taking the largest."
msgstr "Na staklu je više kartica, uzimam najveću."

#: src/id2pdf/scanner.py:91
msgid "Scanning the card..."
msgstr "Skeniram osobnu..."

#: src/id2pdf/scanner.py:118
#, python-brace-format
msgid "Put page {n} of {pages} face down on the glass and close the lid."
msgstr ""
"Stavite {n}. od {pages} stranica licem prema staklu i zatvorite poklopac."

#: src/id2pdf/scanner.py:119
msgid "Scanning..."
msgstr "Skeniram..."

#: src/id2pdf/scanner.py:126
msgid "Put the card on the glass as usual and close the lid."
msgstr "Stavite osobnu na staklo kao inače i zatvorite poklopac."

#: src/id2pdf/scanner.py:131
#, python-brace-format
msgid "Glass: {width:.1f} x {height:.1f} mm, lid (median grey): {lid:.0f}"
msgstr ""
"Staklo: {width:.1f} x {height:.1f} mm, poklopac (medijan sive): {lid:.0f}"

#: src/id2pdf/scanner.py:136
#, python-brace-format
msgid "Objects found: {count} (largest first; a card is 85.6 x 54 mm)"
msgstr "Pronađeno objekata: {count} (najveći prvi; osobna je 85.6 x 54 mm)"

#: src/id2pdf/scanner.py:137
msgid "shape"
msgstr "oblik"

#: src/id2pdf/scanner.py:137
msgid "size"
msgstr "veličina"

#: src/id2pdf/scanner.py:137
msgid "too small"
msgstr "premalo"

#: src/id2pdf/scanner.py:142
#, python-brace-format
msgid "rejected ({reason})"
msgstr "odbijeno ({reason})"

#: src/id2pdf/scanner.py:146
#, python-brace-format
msgid "CARD, without its shadow: {size} mm"
msgstr "OSOBNA, bez sjene: {size} mm"

#: src/id2pdf/scanner.py:150
#, python-brace-format
msgid ""
"{long:6.1f} x {short:5.1f} mm  ratio {ratio:4.2f}  centre ({where}) mm  "
"angle {angle:5.1f}  {verdict}"
msgstr ""
"{long:6.1f} x {short:5.1f} mm  omjer {ratio:4.2f}  sredina ({where}) mm  kut "
"{angle:5.1f}  {verdict}"

#: src/id2pdf/scanner.py:157
#, python-brace-format
msgid ""
"The scan is saved only on this computer: {path} (it shows the card, do not "
"share it)."
msgstr ""
"Sken je spremljen samo na ovom računalu: {path} (na njemu je osobna, ne "
"šaljite ga)."
